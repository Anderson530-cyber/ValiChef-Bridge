[Unit]
Description=ValiChef Bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=valichef
WorkingDirectory=/home/valichef/valichef-bridge
EnvironmentFile=/etc/valichef-bridge.env
ExecStart=/home/valichef/valichef-bridge/venv/bin/python /home/valichef/valichef-bridge/bridge.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target