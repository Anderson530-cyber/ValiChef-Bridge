# ValiChef Bridge - configuração local
# Copie para /etc/valichef-bridge.env no mini PC.
# NUNCA salve os valores reais deste arquivo no GitHub.

VALICHEF_API_URL=
VALICHEF_BRIDGE_SECRET=
VALICHEF_BRIDGE_ID=
VALICHEF_RESTAURANTE_ID=
VALICHEF_IMPRESSORA_ID=

VALICHEF_PRINTER_HOST=
VALICHEF_PRINTER_PORT=9100

VALICHEF_HEARTBEAT_INTERVAL=30
VALICHEF_QUEUE_INTERVAL=0.25
VALICHEF_CAMERA_SESSION_INTERVAL=0.5
VALICHEF_CAMERA_PASSWORDS_JSON={}
